.target-window {
    width: 175px;
    height: 46px;
    align-self: auto;
    justify-content: space-evenly;
    align-items: flex-start;
    flex-direction: row;
    margin-top: -1px;
    margin-right: -1px;
    margin-bottom: -1px;
    margin-left: -2px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    transform-origin: left top;
}

.target-window-bg {
    flex-grow: 1;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 4px;
    padding-right: 5px;
    padding-bottom: 2px;
    padding-left: 4px;
    height: 43px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    flex-shrink: 0;
}

.target-window-size-control {
    flex-grow: 1;
    flex-shrink: 0;
    height: 43px;
    max-width: 5px;
    margin-top: 1px;
    margin-bottom: 2px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: auto;
    margin-right: 0;
    margin-left: -3px;
    padding-top: 0;
    padding-bottom: 0;
    flex-basis: auto;
    padding-right: 0;
    padding-left: 0;
    background-image: resource('Data/UI/Assets/Frame/Frame_DF_Ver/ps_sizecontrol1');
    -unity-slice-scale: 1px;
    -unity-slice-top: 3;
    -unity-slice-bottom: 3;
    -unity-slice-right: 0;
    -unity-slice-left: 0;
    width: 6px;
}

.target-window-resize-handle {
    flex-grow: 1;
    flex-shrink: 0;
    height: 16px;
    max-width: 16px;
    margin-top: 0;
    margin-bottom: 0;
    flex-direction: column;
    justify-content: flex-start;
    align-items: auto;
    margin-right: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-basis: auto;
    padding-right: 0;
    padding-left: 0;
    background-image: resource('Data/UI/Assets/Frame/Frame_DF_Ver/ps_sizecontrol2');
    -unity-slice-scale: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-right: 8;
    -unity-slice-left: 0;
    width: 7px;
    max-height: 16px;
    position: absolute;
    top: 5px;
    left: 0;
}

.target-window-close-btn {
    position: absolute;
    right: 8px;
    top: 6px;
    width: 16px;
    height: 16px;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
}

.target-window-inner {
    flex-grow: 1;
}

.target-window-target-name {
    flex-grow: 0;
    font-size: 10px;
    letter-spacing: 3px;
    height: 12px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;

}

.target-window-bar-container {
    flex-grow: 1;
}

.target-bar-container {
    margin-top: 4px;
    opacity: 0;
}

.target-bar-container.visible {
    opacity: 100;
}

.target-window .bar-container {
    height: 14px;
}

.target-window .l2-bar {
    min-height: 8px;
    
    max-height: 8px;
}
.target-window .l2-bar-bg {
    min-height: 8px;
    max-height: 8px;
}

.target-window .l2-bar-front {
    min-height: 8px;
    max-height: 8px;
}

.target-window .l2-bar-left {
    min-width: 2px;
    max-width: 2px;
}

.target-window .l2-bar-right {
    min-width: 2px;
    max-width: 2px;
}


.target-window .bar-label {
    display:none;
}

.target-window-drag {
    height: 46px;
    width: 16px;
    max-width: 16px;
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-start;
    align-self: auto;
    -unity-background-scale-mode: stretch-to-fill;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}