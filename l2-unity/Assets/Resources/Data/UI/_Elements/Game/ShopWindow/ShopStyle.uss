.shop-window {
    width: 522px;
    height: 450px;
    position: absolute;
    font-size: 11px;
}

.shop-window .transparent-cursor {
    --unity-cursor-color: rgba(0, 0, 0, 0);
}

.shop-window .l2-flex-button {
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    font-size: 11;
}

.shop-window .l2-input-field {
    margin-top: 2;
    margin-left: 5;
    margin-right: 5;
    margin-bottom: 0;
    font-size: 11px;
}

.shop-window-content-container {
    flex-grow: 1;
    position: absolute;
    width: 514px;
    height: 410px;
    top: 38px;
    left: 4px;
    padding-top: 0;
    padding-right: 6px;
    padding-left: 8px;
    padding-bottom: 8px;
}

.shop-window .l2-scroll-view .unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
}

.shop-window .unity-tab__header-label {
    color: rgb(220, 220, 220);
    font-size: 11px;
    padding-bottom: 2px;
    margin: 0;
}

.shop-window .unity-tab__content-container {
    flex-grow: 1;
}

.shop-window .unity-tab {
    flex-grow: 1;
    height: 1px;
    margin-bottom: -2px;
}

.shop-window .unity-scroll-view {
    font-size: 12px;
}

.shop-window .unity-base-slider__dragger-border {
    border-width: 0;
    margin: 0;
    padding: 0;
}

.shop-window .unity-disabled {
    opacity: 1;
}

.shop-window .unity-tab-view__header-container {
    margin-left: 23px;
}

.shop-window .unity-tab-view__content-container {
    flex-grow: 1;
}

.shop-window #tab-content-container {
    flex-grow: 1;
}

.shop-window .unity-tab__header-underline {
    width: 0;
}

.shop-window .unity-tab__header {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected');
    background-color: transparent;
    -unity-slice-top: 24;
    -unity-slice-left: 5;
    -unity-slice-bottom: 0;
    -unity-slice-right: 5;
    -unity-slice-scale: 1px;
    rotate: 180deg;
    height: 25px;
    padding: 0;
    width: 64px;
    justify-content: center;
}

.shop-window .tab-header {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected');
    background-color: transparent;
    -unity-slice-top: 24;
    -unity-slice-left: 5;
    -unity-slice-bottom: 0;
    -unity-slice-right: 5;
    -unity-slice-scale: 1px;
    height: 25px;
    padding: 0;
    width: 64px;
    justify-content: center;
}

.shop-window .unity-tab__header:checked {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Selected');
}

.shop-window .tab-header.active {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Selected');
}

.shop-window .unity-tab__header:checked:hover {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Selected');
}

.shop-window .tab-header.active:hover {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Selected');
}

.shop-window .unity-tab__header:hover {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected_Over');
}

.shop-window .tab-header:hover {
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Tab_Unselected_Over');
}

.shop-windoww .unity-tab__header-label {
    color: rgb(220, 220, 220);
    font-size: 11px;
    padding-bottom: 2px;
    margin: 0;
    -unity-text-align: middle-center;
}

.shop-window #unity-content-viewport {
    margin: 4px;
    margin-right: 0px;
    padding: 0;
}

.shop-window .tab-header-label {
    color: rgb(220, 220, 220);
    font-size: 11px;
    padding-bottom: 2px;
    margin: 0;
    -unity-text-align: middle-center;
}

.shop-window .unselected-tab {
    display: none;
}

.shop-window .l2-scroll-view .unity-scroller {
    width: 14px;
    margin-right: 2px;
    margin-left: 2px;
}

.shop-content {
    flex-grow: 0;
    min-width: auto;
    min-height: auto;
    justify-content: flex-start;
    align-items: flex-start;
    position: absolute;
    background-image: none;
    top: 0;
    left: 0;
    display: flex;
    visibility: visible;
    overflow: visible;
    flex-shrink: 0;
    width: 100%;
    padding-top: 0;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 38px;
    height: 372px;
}

.shop-content-container {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.shop-content-container-inner {
    position: relative;
    left: 0;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-direction: row;
    align-self: stretch;
    flex-grow: 1;
    padding-right: 0;
}

.shop-item-footer {
    margin-top: 4px;
    margin-right: 0;
    margin-bottom: 2px;
    margin-left: 0;
    padding-top: 3px;
    padding-bottom: 0;
    padding-left: 0;
    height: 44px;
    flex-direction: row;
    flex-grow: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0.35);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgba(111, 111, 111, 0.24);
}

.shop-tab-view-container {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    padding-left: 0;
    padding-top: 5px;
    padding-right: 0;
    padding-bottom: 0;
}

.shop-tab-header-container {
    flex-direction: row-reverse;
    margin-left: 8px;
    margin-bottom: -4px;
}

.shop-tab-content-container {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column-reverse;
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_bg');
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    padding-top: 7px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    margin-bottom: 0;
}

.shop-tab-line {
    flex-grow: 1;
    margin-right: 5px;
    background-image: resource('Data/UI/Assets/Tab/Tab_DF_Bg_line');
    margin-bottom: -7px;
}

.shop-button-bg {
    flex-grow: 1;
    width: 64px;
    height: 64px;
    top: -2px;
}

.item-statistics-container {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 4px;
    flex-direction: column;
    align-self: stretch;
    justify-content: flex-start;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 0;
    font-size: 11px;
    padding-right: 4px;
}

.item-statistic-icons {
    flex-direction: column;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    left: 10px;
}

.item-statistic-icon {
    flex-grow: 1;
    width: 32px;
    height: 16px;
    max-width: 32px;
    max-height: 16px;
    margin-top: 2px;
}

.icon-adena {
    background-image: resource('Data/UI/Assets/Inventory/icon_df_common_adena');
}

.icon-bag {
    background-image: resource('Data/UI/Assets/Inventory/icon_df_common_weight');
}

.item-statistic-gauges {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 1;
    min-width: 128px;
    max-width: 128px;
}

.shop-tab {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
}

.shop-small-tab-container {
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: row;
}

.shop-button-bar {
    flex-grow: 0;
    flex-direction: row;
    justify-content: center;
    height: 34px;
    padding-top: 4px;
}

.shop-button {
    width: 80px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 4px;
    margin-right: 4px;
}

.shop-button .l2-flex-button-label {
    padding-top: 6px;
    padding-bottom: 6px;
}

.shop-divider {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 3px;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 4px;
    background-image: resource('Data/UI/Assets/CharInfo/Divider_DF_Ver');
}

.shop-statistic-icon {
    width: 18px;
    max-width: 18px;
    margin-right: 4px;
}

.shop-statistic-label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 1;
    width: 40px;
}

.shop-statistic-gauge {
    flex-grow: 0;
    max-width: 128px;
    width: 128px;
}

.small-tab-container-inner {
    flex-grow: 1;
    margin-right: 8px;
    flex-shrink: 0;
    width: 240px;
    max-width: 240px;
}

.shop-statistic-row {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    height: 18px;
}