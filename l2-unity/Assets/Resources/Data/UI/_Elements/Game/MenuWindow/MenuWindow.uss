.menu-btn {
    display: flex;
}

.menu-btn-grp {
    margin-top: 5px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 6px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 0;
    height: auto;
    flex-direction: row;
    flex-shrink: 0;
    flex-wrap: wrap;
    width: 161px;
    overflow: visible;
    display: flex;
    opacity: 1;
}
