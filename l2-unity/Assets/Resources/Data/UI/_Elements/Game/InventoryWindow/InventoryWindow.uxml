<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="WindowTemplate" src="project://database/Assets/Resources/Data/UI/_Elements/Components/WindowTemplate.uxml?fileID=9197481963319205126&amp;guid=5ca840f56ef6f1044b4dc077c7d3e6e6&amp;type=3#WindowTemplate" />
    <ui:Template name="L2TabView" src="project://database/Assets/Resources/Data/UI/_Elements/Components/L2TabView/L2TabView.uxml?fileID=9197481963319205126&amp;guid=df1c3d52e66191742a30ae9bd4520b5a&amp;type=3#L2TabView" />
    <ui:Template name="L2Bar" src="project://database/Assets/Resources/Data/UI/_Elements/Components/L2Bar/L2Bar.uxml?fileID=9197481963319205126&amp;guid=e7da9ee05d38b14459d91eca9fc49926&amp;type=3#L2Bar" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/Game/InventoryWindow/InventoryWindow.uss?fileID=7433441132597879392&amp;guid=4eda97cd2431b9546835901512514faa&amp;type=3#InventoryWindow" />
    <ui:Instance template="WindowTemplate" class="inventory-window" style="display: flex; position: absolute;">
        <ui:VisualElement name="ExtraHeader" class="inventory-extra-buttons">
            <ui:Label tabindex="-1" text="(0/80)" parse-escape-sequences="true" display-tooltip-when-elided="true" name="InventoryCount" class="l2-color-2 inventory-count" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Expand-Window-Button" class="btn-exp-frame expand-btn">
                <ui:VisualElement name="ButtonBg" class="expand-btn-bg" />
            </ui:Button>
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Minimize-Window-Button" class="btn-coll-frame minimize-btn" />
        </ui:VisualElement>
        <ui:VisualElement name="Content" class="inventory-content">
            <ui:VisualElement name="Container" class="inventory-content-container">
                <ui:GroupBox name="BoxContent" class="inventory-content-container-inner">
                    <ui:VisualElement name="Gear" class="inventory-gear-container">
                        <ui:VisualElement name="GearContent" class="inventory-gear">
                            <ui:VisualElement name="GearRow1" class="inventory-gear-row-1">
                                <ui:VisualElement name="Hat1" style="flex-grow: 0; width: 34px; margin-left: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Helmet" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Hat2" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GearRow2" class="inventory-gear-row-2">
                                <ui:VisualElement name="Gloves" style="flex-grow: 0; width: 34px; margin-left: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Torso" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Boots" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GearRow3" class="inventory-gear-row-3">
                                <ui:VisualElement name="Underwear" style="flex-grow: 0; width: 34px; margin-left: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Legs" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Belt" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GearRow4" class="inventory-gear-row-4">
                                <ui:VisualElement name="Rhand" style="flex-grow: 0; width: 34px; margin-left: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Lhand" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Agathion" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GearRow5" class="inventory-gear-row-5">
                                <ui:VisualElement name="Neck" style="flex-grow: 0; width: 34px; margin-left: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Rear" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Lear" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                            </ui:VisualElement>
                            <ui:VisualElement name="GearRow6" class="inventory-gear-row-6">
                                <ui:VisualElement name="Pendant" style="flex-grow: 0; width: 34px; margin-left: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Rring" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                                <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
                                <ui:VisualElement name="Lring" style="flex-grow: 0; width: 34px; margin-right: 1px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="InventoryContent" class="inventory-item-container">
                        <ui:Instance template="L2TabView" name="InventoryTabView" style="flex-grow: 1;" />
                        <ui:GroupBox name="Footer" class="inventory-item-footer">
                            <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AdenaDistribBtn" class="l2-button inventory-button">
                                <ui:VisualElement name="ButtonBg" class="l2-button-bg inventory-button-bg" />
                            </ui:Button>
                            <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CompoundBtn" class="l2-button inventory-button">
                                <ui:VisualElement name="ButtonBg" class="l2-button-bg inventory-button-bg" />
                            </ui:Button>
                            <ui:VisualElement style="flex-grow: 1;" />
                            <ui:GroupBox name="StatisticBox" class="item-statistics-container">
                                <ui:GroupBox name="Image" class="item-statistic-icons">
                                    <ui:VisualElement class="item-statistic-icon icon-adena" />
                                    <ui:VisualElement class="item-statistic-icon icon-bag" />
                                </ui:GroupBox>
                                <ui:GroupBox name="Gauge" class="item-statistic-gauges">
                                    <ui:GroupBox name="TextBox" class="inventory-adena-box">
                                        <ui:GroupBox class="inventory-adena-box-inner">
                                            <ui:Label tabindex="-1" text="0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AdenaCount" class="inventory-adena-count" />
                                        </ui:GroupBox>
                                    </ui:GroupBox>
                                    <ui:Instance template="L2Bar" name="WeightBar" class="l2-bar weight-3">
                                        <AttributeOverrides element-name="Text" text="100.00%" />
                                    </ui:Instance>
                                </ui:GroupBox>
                            </ui:GroupBox>
                            <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TrashBtn" class="l2-button inventory-button">
                                <ui:VisualElement name="ButtonBg" class="l2-button-bg inventory-button-bg" />
                            </ui:Button>
                        </ui:GroupBox>
                    </ui:VisualElement>
                </ui:GroupBox>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:Instance>
</ui:UXML>
