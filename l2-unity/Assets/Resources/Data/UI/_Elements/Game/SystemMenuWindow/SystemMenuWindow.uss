.system-menu-window {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-image: resource('Data/UI/Assets/Menu/bg_menu_original');
    flex-grow: 0;
    width: 165px;
    position: absolute;
}

.system-menu-window-container {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 1px;
    padding-bottom: 3px;
    padding-left: 0;
    width: 100%;
    opacity: 0.95;
    -unity-slice-left: 15;
    -unity-slice-top: 15;
    -unity-slice-right: 15;
    -unity-slice-bottom: 15;
    -unity-slice-scale: 1px;
}

.system-menu {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 1px;
    position: relative;
    left: 0;
    top: 1%;
    display: flex;
    visibility: visible;
    overflow: visible;
}

.system-menu-button-bg {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
}

.system-menu-row {
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-items: auto;
    align-self: flex-start;
    width: 100%;
}

.system-menu-button-bg {
}

.system-menu-button-content {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 10px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-direction: row;
    align-self: center;
    flex-grow: 0;
    width: 100%;
}

.system-menu-row-icon {
    flex-grow: 1;
    width: 14px;
    height: 15px;
    background-image: resource('Data/UI/Assets/Menu/Icon_df_SystemMenuWnd_ReStart_clear');
    max-width: 16px;
    max-height: 16px;
    opacity: 1;
}

.system-menu-row-text {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 7px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(223, 222, 222);
    font-size: 13px;
    align-self: flex-start;
    align-items: flex-start;
    -unity-text-outline-width: 0.1px;
}

.system-menu-row {
    padding: 0;
    margin: 1px 0;
    height: 20px;
    justify-content: center;
}

.system-menu-row:active #Bg {
    opacity: 0.7;
}

.system-menu-row:active:hover #Bg {
    background-image: resource('Data/UI/Assets/Menu/icon_over_items_menu');
}

.system-menu-row:hover #Bg {
    background-image: resource('Data/UI/Assets/Menu/icon_over_items_menu');
}