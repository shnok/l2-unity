.l2-button {
    flex-grow: 0;
    width: 92px;
    height: 22px;
    background-image: none;
    -unity-slice-right: 15;
    -unity-slice-left: 15;
    -unity-slice-top: 15;
    -unity-slice-bottom: 15;
    -unity-slice-scale: 1px;
    font-size: 12px;
    background-color: transparent;
}

.l2-button:active .l2-button-bg {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Down');
}

.l2-button:active:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Down');
}

.l2-button:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Button/Button_DF_Over');
}

.l2-button-bg {
    flex-grow: 1;
    background-image: resource('Data/UI/Assets/Button/Button_DF');
    height: 22px;
    min-height: 32px;
    position: absolute;
    -unity-slice-left: 15;
    -unity-slice-top: 15;
    -unity-slice-right: 15;
    -unity-slice-bottom: 15;
    width: 100%;
}

.l2-button-ele {
    margin-top: auto;
    margin-right: 5px;
    margin-bottom: auto;
    margin-left: auto;
    padding-top: 10px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 0;
    background-image: none;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-scale: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    background-color: rgba(127, 127, 127, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 100%;
    height: 100%;
    -unity-font: resource('Data/UI/Assets/Font/tahoma');
    color: rgb(255, 255, 255);
}

.l2-button-ele {
    padding-right: 0;
    margin-right: 0;
}

.l2-button-bg {
    width: 105%;
}

.l2-button-bg {
