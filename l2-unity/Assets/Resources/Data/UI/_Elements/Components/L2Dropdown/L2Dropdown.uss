.l2-dropdown {
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 16px;
    color: white;
}

.l2-dropdown.unity-base-field {
    margin-top: 0;
}

.l2-dropdown .unity-base-field__input {
    padding: 0;
    margin: 0;
    background-color: transparent;
    background-image: resource('Data/UI/Assets/Login/CharacterPassword_DF_EditBox_Scaled');
    -unity-slice-top: 10;
    -unity-slice-left: 10;
    -unity-slice-bottom: 10;
    -unity-slice-right: 10;
    -unity-slice-scale: 1px;
    border-width: 0px;
    min-width: 0;
}

.l2-dropdown .unity-base-popup-field__arrow {
    height: 16px;
    width: 16px;
    margin-left: 2px;
    margin-top: 2px;
    -unity-background-image-tint-color: white;
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarDownBtn');
}

.l2-dropdown .unity-base-popup-field__text {
    margin: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.l2-dropdown:hover .unity-base-popup-field__arrow {
    background-image: resource('Data/UI/Assets/Scrollbar/scrollbardownbtn_over');
}

.l2-dropdown:active .unity-base-popup-field__arrow {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarDownOnBtn');
}

.l2-dropdown:active:hover .unity-base-popup-field__arrow {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarDownOnBtn');
}

.l2-dropdown.unity-base-popup-field:focus:enabled > .unity-base-field__input {
    background-color: transparent;
}
.l2-dropdown.unity-base-popup-field:active:enabled > .unity-base-field__input {
    background-color: transparent;
}
.l2-dropdown.unity-base-popup-field:hover:enabled > .unity-base-field__input {
    background-color: transparent;
}
.l2-dropdown.unity-base-popup-field:hover > .unity-base-field__input {
    background-color: transparent;
}

.unity-base-dropdown {
    cursor: resource('Data/UI/Assets/Cursor/Default');
    -unity-font-definition: resource('Data/UI/Assets/Font/tahoma');
    text-shadow: 0.5px 0.5px 3px rgb(0, 0, 0);
}

.unity-base-dropdown__container-outer .unity-scroll-view__content-viewport {
    margin-top: 0px;
    margin-bottom: 0px;
    overflow: hidden;
}

.unity-base-dropdown__container-outer .unity-base-dropdown__container-inner {
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(0,0,0,0.4);
    background-image: resource('Data/UI/Assets/Menu/bg_menu_original');
    overflow: hidden;
    color: white;
}

.unity-base-dropdown__container-outer .unity-scroller {
    width: 14px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 2px;
    margin-bottom: 0;
}

.unity-base-dropdown__container-outer .unity-slider {
    margin: 15px 0 15px 0;
}

.unity-base-dropdown__container-outer .unity-base-slider__tracker:hover {
    background-color: transparent;
}
.unity-base-dropdown__container-outer .unity-base-slider__tracker:hover:enabled {
    background-color: transparent;
}

.unity-base-dropdown__container-outer .unity-base-slider__drag-container {
    background-color: transparent;
    min-width: 14px;
    width: 14px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}

.unity-base-dropdown__container-outer .unity-slider {
    background-color: transparent;
    min-width: 14px;
    width: 14px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}

.unity-base-dropdown__container-outer .unity-base-slider__tracker {
    background-color: transparent;
    min-width: 14px;
    width: 14px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}

.unity-base-dropdown__container-outer .unity-base-slider__dragger {
    min-width: 14px;
    width: 14px;
    margin-left: -3px;
    background-image: resource('Data/UI/Assets/Scrollbar/SliderBar');
    background-color: transparent;
    -unity-slice-top: 0;
    -unity-slice-left: 0;
    -unity-slice-bottom: 2;
    -unity-slice-right: 2;
    -unity-slice-scale: 0;
    border-width: 0;
}
.unity-base-dropdown__container-outer .unity-base-slider__dragger:hover:enabled {
    background-color: transparent;
}

.unity-base-dropdown__container-outer .unity-scroller__high-button {
    background-color: transparent;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-top: 0;
    -unity-slice-left: 0;
    -unity-slice-bottom: 2;
    -unity-slice-right: 2;
    -unity-slice-scale: 0;
    width: 14px;
    height: 14px;
    border-width: 0;
}

.unity-base-dropdown__container-outer .unity-scroller__low-button {
    background-color: transparent;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-top: 0;
    -unity-slice-left: 0;
    -unity-slice-bottom: 2;
    -unity-slice-right: 2;
    -unity-slice-scale: 0;
    width: 14px;
    height: 14px;
    border-width: 0;
}

.unity-base-dropdown__container-outer .unity-scroller__high-button {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarDownBtn');
}

.unity-base-dropdown__container-outer .unity-scroller__high-button:active {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarDownOnBtn');
}

.unity-base-dropdown__container-outer .unity-scroller__high-button:active:hover {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarDownOnBtn');
}

.unity-base-dropdown__container-outer .unity-scroller__high-button:hover {
    background-image: resource('Data/UI/Assets/Scrollbar/scrollbardownbtn_over');
}

.unity-base-dropdown__container-outer .unity-scroller__low-button {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarUpBtn');
}

.unity-base-dropdown__container-outer .unity-scroller__low-button:active {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarUpOnBtn');
}

.unity-base-dropdown__container-outer .unity-scroller__low-button:active:hover {
    background-image: resource('Data/UI/Assets/Scrollbar/ScrollBarUpOnBtn');
}

.unity-base-dropdown__container-outer .unity-scroller__low-button:hover {
    background-image: resource('Data/UI/Assets/Scrollbar/scrollbarupbtn_over');
}

.unity-base-dropdown__container-outer .unity-scroller--horizontal {
    display: none;
    max-width: 0;
    max-height: 0;
    overflow: hidden;
}

.unity-base-dropdown__container-outer .unity-base-dropdown__checkmark {
    display: none;
    max-width: 0;
    max-height: 0;
    overflow: hidden;
}

.unity-base-dropdown__container-outer .unity-base-dropdown__label {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 2px;
    padding-bottom: 2px;
}