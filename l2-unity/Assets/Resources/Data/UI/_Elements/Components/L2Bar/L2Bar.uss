.inventory-window #WeightBar {
    margin-top: 2px;
}

.inventory-window #WeightBar #Text {
    font-size: 11px;
    text-shadow: 0.5px 0.5px 3px rgb(0, 0, 0);
}

.inventory-adena-box {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 2px;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 16px;
}

.inventory-adena-box-inner {
    background-color: rgb(22, 22, 22);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 18px;
    border-left-color: rgb(59, 59, 59);
    border-right-color: rgb(59, 59, 59);
    border-top-color: rgb(59, 59, 59);
    border-bottom-color: rgb(59, 59, 59);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    flex-direction: row-reverse;
}

.inventory-adena-count {
    margin-top: 0;
    margin-right: 1px;
    margin-left: 0;
    padding-top: 1;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-self: flex-end;
    font-size: 11px;
    color: rgb(223, 222, 222);
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.l2-bar.status .l2-bar-status-label {
    display: flex;
}

.l2-bar-status-label {
    position: absolute;
    display: none;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 8px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-definition: resource('Data/UI/Assets/Font/asiahm-medium');
    text-shadow: 0.9px 0.9px 3px rgb(0, 0, 0);
    -unity-text-outline-width: 0.7px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
    letter-spacing: -18px;
    font-size: 12px;
}