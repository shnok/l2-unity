.login-window {
    flex-grow: 0;
    width: 260px;
    height: 110px;
    flex-shrink: 0;
    background-image: resource('Data/UI/Assets/Windows/Windows_DF_Drawer_Bg_Darker');
    -unity-slice-bottom: 10;
    -unity-slice-left: 27;
    -unity-slice-top: 10;
    -unity-slice-right: 20;
    margin-top: auto;
    margin-right: auto;
    margin-bottom: auto;
    margin-left: auto;
    padding-top: 18px;
    padding-right: 28px;
    padding-bottom: 13px;
    padding-left: 22px;
}

.login-window .unity-text-field {
    --unity-cursor-color: rgb(255, 255, 255);
}

.login-window .transparent-cursor {
    --unity-cursor-color: rgba(0, 0, 0, 0);
}

.login-window .l2-input-field {
    margin-bottom: 4px;
}

.login-window .l2-input-field > .unity-label {
    width: 60px;
}

.login-window .l2-input-field > .unity-label {
    width: 60px;
}

.login-window .login-buttons {
    flex-grow: 1;
    flex-direction: row;
    -unity-text-align: upper-left;
    justify-content: center;
    margin-top: 3px;
    flex-shrink: 0;
}

.login-window .l2-flex-button {
    padding: 0;
    width: 90px;
}

.login-window .l2-flex-button-label {
    padding-top: 6px;
    padding-bottom: 6px;
}

.login-window .l2-input-field-template {
}