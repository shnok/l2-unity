<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="L2Input" src="project://database/Assets/Resources/Data/UI/_Elements/Components/L2Input/L2Input.uxml?fileID=9197481963319205126&amp;guid=dce83b8dcd7f5614280886eaaa82f0f7&amp;type=3#L2Input" />
    <ui:Template name="L2Button" src="project://database/Assets/Resources/Data/UI/_Elements/Components/L2Button/L2Button.uxml?fileID=9197481963319205126&amp;guid=47796068f89476143b10b5d383be52fc&amp;type=3#L2Button" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/Components/L2Button/L2Button.uss?fileID=7433441132597879392&amp;guid=b1d2114f9ed155f45a3eb16e5ef02441&amp;type=3#L2Button" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/Components/L2Input/L2Input.uss?fileID=7433441132597879392&amp;guid=2fa480f78160edf4a8c4381744578912&amp;type=3#L2Input" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/Login/CharCreationWindow/CharCreationWindow.uss?fileID=7433441132597879392&amp;guid=a8431f6f3c5f8b94ca503b0fe8975a58&amp;type=3#CharCreationWindow" />
    <ui:VisualElement name="CharCreationWindow" class="char-creation-window">
        <ui:VisualElement class="char-creation-col-1">
            <ui:VisualElement tabindex="-1" name="CharCreationDetailWindow" class="char-creation-detail-window">
                <ui:Instance template="L2Input" name="UserInputField">
                    <AttributeOverrides element-name="L2Input" label="Name" max-length="12" auto-correction="false" />
                </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="char-creation-col-2">
            <ui:VisualElement name="CharacterRotateWindow" class="char-creation-rotation">
                <ui:Button text="&#10;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TurnLeftButton" tabindex="-1" focusable="false" class="turn-left-button">
                    <ui:VisualElement name="ButtonBg" tabindex="-1" class="l2-button-bg" style="width: 64px; height: 64px;" />
                </ui:Button>
                <ui:Button text="&#10;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ZoomButton" tabindex="-1" focusable="false" class="zoom-button">
                    <ui:VisualElement name="ButtonBg" tabindex="-1" class="l2-button-bg" style="width: 64px; height: 64px;" />
                </ui:Button>
                <ui:Button text="&#10;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TurnRightButton" tabindex="-1" focusable="false" class="turn-right-button">
                    <ui:VisualElement name="ButtonBg" tabindex="-1" class="l2-button-bg" style="width: 64px; height: 64px;" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="char-creation-col-3">
            <ui:VisualElement name="MenuWindow" tabindex="-1" class="char-creation-menu">
                <ui:Instance template="L2Button" name="CreateButton" class="l2-button-template">
                    <AttributeOverrides element-name="ButtonLabel" text="Create" />
                </ui:Instance>
                <ui:Instance template="L2Button" name="PreviousButton" class="l2-button-template">
                    <AttributeOverrides element-name="ButtonLabel" text="Previous" />
                </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
