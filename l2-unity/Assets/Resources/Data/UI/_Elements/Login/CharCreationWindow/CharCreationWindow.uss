.char-creation-window {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    flex-direction: row;
}

.char-creation-detail-window {
    flex-grow: 0;
    width: 250px;
    height: auto;
    flex-shrink: 0;
    background-image: resource('Data/UI/Assets/Windows/Windows_DF_Drawer_Bg_Darker');
    -unity-slice-bottom: 10;
    -unity-slice-left: 27;
    -unity-slice-top: 10;
    -unity-slice-right: 20;
    margin-right: 0;
    margin-left: 10px;
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    margin-top: 10px;
    margin-bottom: 0;
    align-self: flex-start;
}

.char-creation-col-1 {
    flex-grow: 1;
    width: 33.3%;
    justify-content: flex-start;
    align-items: flex-end;
    flex-shrink: 0;
    max-width: 33.3%;
    min-width: 33.3%;
}

.char-creation-col-2 {
    flex-grow: 1;
    justify-content: flex-end;
    width: 33.3%;
    max-width: 33.3%;
    min-width: 33.3%;
    align-items: center;
}

.char-creation-col-3 {
    flex-grow: 1;
    flex-direction: row-reverse;
    align-self: auto;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: nowrap;
    width: 33.3%;
    max-width: 33.3%;
    min-width: 33.3%;
}

.char-creation-rotation {
    flex-grow: 0;
    height: 50px;
    min-height: auto;
    min-width: auto;
    flex-shrink: 0;
    flex-direction: row;
    margin-bottom: 100px;
}

.char-creation-menu {
    flex-grow: 0;
    width: 109px;
    height: auto;
    flex-shrink: 0;
    background-image: resource('Data/UI/Assets/Windows/Windows_DF_Drawer_Bg_Darker');
    -unity-slice-bottom: 10;
    -unity-slice-left: 27;
    -unity-slice-top: 10;
    -unity-slice-right: 20;
    margin-right: 20px;
    margin-left: 0;
    padding-top: 10px;
    padding-right: 5px;
    padding-bottom: 60px;
    padding-left: 5px;
    margin-top: 0;
    margin-bottom: 30px;
    align-self: flex-end;
}

.char-creation-window #UserInputField {
    margin-bottom: 20px;
}

.char-creation-window .transparent-cursor {
    --unity-cursor-color: rgba(0, 0, 0, 0);
}

.char-creation-window .unity-text-field {
    --unity-cursor-color: rgb(255, 255, 255);
    color: rgb(220, 220, 220);
}

.char-creation-window .unity-base-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: rgb(220, 220, 220);
}

.char-creation-window .l2-flex-button-label {
    padding-top: 6px;
    padding-bottom: 6px;
}

.char-creation-window #TurnLeftButton .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_LEFT');
}

.char-creation-window #TurnLeftButton:active .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_LEFT_Down');
}

.char-creation-window #TurnLeftButton:active:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_LEFT_Down');
}

.char-creation-window #TurnLeftButton:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_LEFT_Over');
}

.char-creation-window #TurnRightButton .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_RIGHT');
}

.char-creation-window #TurnRightButton:active .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_RIGHT_DOWN');
}

.char-creation-window #TurnRightButton:active:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_RIGHT_DOWN');
}

.char-creation-window #TurnRightButton:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_RIGHT_OVER');
}

.char-creation-window #ZoomButton .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMIN');
}

.char-creation-window #ZoomButton:active .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMIN_Down');
}

.char-creation-window #ZoomButton:active:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMIN_Down');
}

.char-creation-window #ZoomButton:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMIN_Over');
}

.char-creation-window #ZoomButton.toggle .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMOUT');
}

.char-creation-window #ZoomButton.toggle:active .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMOUT_Down');
}

.char-creation-window #ZoomButton.toggle:active:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMOUT_Down');
}

.char-creation-window #ZoomButton.toggle:hover .l2-button-bg {
    background-image: resource('Data/UI/Assets/Login/ICON_DF_CHARACTERTURN_ZOOMOUT_Over');
}

.char-creation-rotation .unity-button {
    border-width: 0px;
    background-color: transparent;
    overflow: visible;
}

.turn-left-button {
    height: 45px;
    width: 50px;
}

.zoom-button {
    height: 45px;
    width: 50px;
    margin-right: 14px;
    margin-left: 14px;
}

.turn-right-button {
    height: 45px;
    width: 50px;
}
